{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "com.pulsemcp/flightaware",
  "description": "MCP server for FlightAware AeroAPI — flight status & tracking, plus airport boards & delays.",
  "version": "0.0.1",
  "repository": {
    "url": "https://github.com/pulsemcp/mcp-servers",
    "source": "github",
    "subfolder": "experimental/flightaware"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "flightaware-mcp-server",
      "version": "0.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "runtimeArguments": [
        {
          "type": "positional",
          "value": "-y"
        }
      ],
      "environmentVariables": [
        {
          "name": "AEROAPI_API_KEY",
          "description": "Your FlightAware AeroAPI key for flight and airport data access.",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
